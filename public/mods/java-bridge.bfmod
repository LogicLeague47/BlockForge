// BlockForge Mod: Java Bridge — verify your certified Minecraft Java
// Edition account (Microsoft, via the open-source Sisu verifier) and
// search live Java servers by IP. Status + verification only: browsers
// cannot join Java servers in-game, so results are details + copy-IP.
export const manifest = {
  id: 'java-bridge',
  name: 'Java Bridge',
  version: '1.2',
  description: 'Verify your Java account with Microsoft, then search any Java server IP for live status.',
  author: 'BlockForge Dev',
  icon: '⛏️',
};

const LS_VERIFY = 'bf_java_verify';
const LS_RECENT = 'bf_java_recent';
const LS_BACKEND = 'bf_java_backend';
const DEFAULT_BACKEND = 'https://blockforge-api.blockforge.workers.dev';

function backend() {
  try {
    const o = localStorage.getItem(LS_BACKEND);
    if (o) return o.replace(/\/+$/, '');
  } catch (_) {}
  return DEFAULT_BACKEND;
}
function loadVerify() {
  try { return JSON.parse(localStorage.getItem(LS_VERIFY) || 'null'); } catch (_) { return null; }
}
function saveVerify(v) {
  try {
    if (v) localStorage.setItem(LS_VERIFY, JSON.stringify(v));
    else localStorage.removeItem(LS_VERIFY);
  } catch (_) {}
}
function joinAsMc() {
  try { return localStorage.getItem('bf_java_join_as_mc') !== '0'; } catch (_) { return true; }
}
function loadRecent() {
  try { const r = JSON.parse(localStorage.getItem(LS_RECENT) || '[]'); return Array.isArray(r) ? r : []; } catch (_) { return []; }
}
function saveRecent(r) {
  try { localStorage.setItem(LS_RECENT, JSON.stringify(r.slice(0, 8))); } catch (_) {}
}
function esc(s) {
  return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
function cleanMotd(s) {
  return String(s || '').replace(/§[0-9a-fk-or]/g, '').slice(0, 120);
}

let _panel = null;
let _pollTimer = null;
let _api = null;

function el(html) {
  const d = document.createElement('div');
  d.innerHTML = html;
  return d.firstChild;
}

function openPanel() {
  closePanel();
  const v = loadVerify();
  _panel = el(
    '<div id="bf-java-panel" data-bfmod="java-bridge" style="position:fixed;inset:0;z-index:500;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.6);">' +
    '<div style="background:#14141f;border:1px solid #4a4a6a;border-radius:12px;padding:20px 22px;width:min(92vw,480px);max-height:86vh;overflow-y:auto;font:13px monospace;color:#ddd;">' +
    '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">' +
    '<b style="font-size:15px;">⛏️ Java Bridge</b>' +
    '<button id="bf-java-close" style="background:#333;border:1px solid #555;color:#fff;border-radius:6px;padding:4px 10px;cursor:pointer;">✕</button>' +
    '</div>' +
    '<div id="bf-java-acct"></div>' +
    '<div id="bf-java-auth" style="display:none;margin-bottom:12px;padding:10px;border:1px dashed #4a4a6a;border-radius:8px;text-align:center;"></div>' +
    '<div style="display:flex;gap:8px;margin-bottom:8px;">' +
    '<input id="bf-java-ip" placeholder="Server IP — e.g. mc.hypixel.net" style="flex:1;background:#0a0a12;border:1px solid #4a4a6a;color:#fff;border-radius:6px;padding:8px 10px;font:13px monospace;"/>' +
    '<button id="bf-java-search" style="background:#3a4d8c;color:#fff;border:none;border-radius:6px;padding:8px 14px;font:13px monospace;cursor:pointer;">Search</button>' +
    '</div>' +
    '<div id="bf-java-results" style="display:flex;flex-direction:column;gap:6px;"></div>' +
    '<div style="margin-top:10px;font-size:11px;color:#888;">Status + verification only — browsers can\u2019t join Java servers in-game. Copy the IP into Minecraft Java.</div>' +
    '</div></div>'
  );
  document.body.appendChild(_panel);
  _panel.querySelector('#bf-java-close').onclick = closePanel;
  _panel.addEventListener('click', (e) => { if (e.target === _panel) closePanel(); });
  const go = () => doSearch();
  _panel.querySelector('#bf-java-search').onclick = go;
  _panel.querySelector('#bf-java-ip').addEventListener('keydown', (e) => { if (e.key === 'Enter') go(); });
  renderAcct();
  renderRecent();
  if (v && v.msRefresh) silentRefresh(v);
}

function closePanel() {
  if (_pollTimer) { clearInterval(_pollTimer); _pollTimer = null; }
  if (_panel) { _panel.remove(); _panel = null; }
}

function renderAcct() {
  const box = _panel && _panel.querySelector('#bf-java-acct');
  if (!box) return;
  const v = loadVerify();
  if (v && v.name) {
    box.innerHTML =
      '<div style="margin-bottom:12px;padding:10px;border:1px solid #2a6a3a;border-radius:8px;background:rgba(40,180,80,0.08);">' +
      '<div>✅ <b>' + esc(v.name) + '</b> ' + (v.ownsJava ? '<span style="color:#8f8;">(owns Java ✓)</span>' : '<span style="color:#fa5;">(no Java license found)</span>') + '</div>' +
      '<label style="display:flex;align-items:center;gap:6px;margin-top:8px;font-size:11px;color:#aaa;cursor:pointer;"><input type="checkbox" id="bf-java-joinmc"' + (joinAsMc() ? ' checked' : '') + '/> Join multiplayer as <b>' + esc(v.name) + '</b></label>' +
      '<button id="bf-java-out" style="margin-top:8px;background:#333;border:1px solid #555;color:#fff;border-radius:6px;padding:4px 10px;cursor:pointer;">Sign out</button>' +
      '</div>';
    box.querySelector('#bf-java-out').onclick = () => { saveVerify(null); renderAcct(); };
    box.querySelector('#bf-java-joinmc').onchange = (e) => { try { localStorage.setItem('bf_java_join_as_mc', e.target.checked ? '1' : '0'); } catch (_) {} };
  } else {
    box.innerHTML =
      '<div style="margin-bottom:12px;">' +
      '<div style="color:#aaa;margin-bottom:8px;">No Minecraft account linked.</div>' +
      '<button id="bf-java-verify" style="background:#2a6a3a;color:#fff;border:none;border-radius:6px;padding:8px 14px;font:13px monospace;cursor:pointer;">Verify my Java account</button>' +
      '</div>';
    box.querySelector('#bf-java-verify').onclick = startVerify;
  }
}

async function api(path, body) {
  const r = await fetch(backend() + path, {
    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}),
  });
  return r.json();
}

async function startVerify() {
  const authBox = _panel.querySelector('#bf-java-auth');
  authBox.style.display = 'block';
  authBox.innerHTML = '<div style="color:#aaa;">Contacting Microsoft…</div>';
  let d;
  try { d = await api('/api/mc-device', {}); }
  catch (_) { d = null; }
  if (!d || !d.ok || !d.device_code) {
    authBox.innerHTML = '<div style="color:#f55;">Backend offline — Microsoft sign-in needs the BlockForge server (coming back soon). Server search below still works.</div>';
    return;
  }
  authBox.innerHTML =
    '<div style="color:#aaa;">On your phone or PC, open<br><b style="color:#fff;">' + esc(d.verification_uri) + '</b><br>enter code</div>' +
    '<div style="font-size:28px;letter-spacing:4px;color:#ffd75a;margin:8px 0;">' + esc(d.user_code) + '</div>' +
    '<div style="color:#8af;" id="bf-java-wait">Waiting for you…</div>';
  if (_pollTimer) clearInterval(_pollTimer);
  const dc = d.device_code;
  const iv = Math.max(5, d.interval || 5) * 1000;
  _pollTimer = setInterval(async () => {
    let p;
    try { p = await api('/api/mc-poll', { device_code: dc }); }
    catch (_) { return; }
    if (!p || !p.ok) return;
    if (p.failed) {
      clearInterval(_pollTimer); _pollTimer = null;
      authBox.innerHTML = '<div style="color:#f55;">' + esc(p.reason || 'Sign-in failed.') + '</div>';
      return;
    }
    if (p.done) {
      clearInterval(_pollTimer); _pollTimer = null;
      // The worker stops at the Xbox stage (Mojang's edge blocks datacenter
      // IPs and sends no CORS headers). The phone finishes the last three
      // calls natively — no browser rules, home/mobile network.
      if (p.stage === 'xsts' && p.xstsToken && p.uhs) {
        finishMojang(p, authBox);
        return;
      }
      saveVerify({ name: p.name, uuid: p.uuid, ownsJava: !!p.ownsJava, mcToken: p.mcToken || null, msRefresh: p.msRefresh || null, at: Date.now() });
      authBox.style.display = 'none';
      renderAcct();
    }
  }, iv);
}

function nativeBridge() {
  try {
    const pl = window.Capacitor && window.Capacitor.Plugins;
    const b = pl && pl.BFUpdate;
    if (b && typeof b.mcPost === 'function') return b;
  } catch (_) {}
  return null;
}

async function mcNative(path, bearer, body) {
  const nat = nativeBridge();
  if (!nat) throw new Error('no-native');
  const r = await nat.mcPost({
    url: 'https://api.minecraftservices.com' + path,
    method: body ? 'POST' : 'GET',
    body: body ? JSON.stringify(body) : '',
    bearer: bearer || '',
  });
  let j = null;
  try { j = JSON.parse(r.body || 'null'); } catch (_) {}
  return { status: r.status, json: j };
}

// Completes verification on the phone: login → ownership → profile.
async function finishMojang(p, authBox) {
  const show = (html) => { if (authBox) { authBox.style.display = 'block'; authBox.innerHTML = html; } };
  if (!nativeBridge()) {
    show('<div style="color:#fa5;">Xbox approved! One last step needs the <b>BlockForge Android app</b> (browsers are blocked from calling Mojang). Open this mod in the app and verify there — your code still works for a few minutes, or grab a fresh one.</div>');
    return;
  }
  show('<div style="color:#aaa;">Xbox approved — asking Mojang…</div>');
  try {
    const login = await mcNative('/authentication/login_with_xbox', '', { identityToken: 'XBL3.0 x=' + p.uhs + ';' + p.xstsToken });
    const mcToken = login.json && login.json.access_token;
    if (login.status !== 200 || !mcToken) throw new Error('mojang-says-no');
    let ownsJava = false;
    try {
      const ent = await mcNative('/entitlements/mcstore', mcToken, null);
      const items = (ent.json && ent.json.items) || [];
      ownsJava = items.some((it) => it && (it.name === 'game_minecraft' || it.name === 'product_minecraft'));
    } catch (_) {}
    let name = '', uuid = '';
    try {
      const prof = await mcNative('/minecraft/profile', mcToken, null);
      if (prof.status === 200 && prof.json) { name = prof.json.name || ''; uuid = prof.json.id || ''; }
    } catch (_) {}
    saveVerify({ name, uuid, ownsJava, mcToken, msRefresh: p.msRefresh || null, at: Date.now() });
    if (authBox) authBox.style.display = 'none';
    renderAcct();
  } catch (_) {
    show('<div style="color:#f55;">Mojang refused the login. Retry with a fresh code.</div>');
  }
}

async function silentRefresh(v) {
  try {
    const p = await api('/api/mc-refresh', { refresh_token: v.msRefresh });
    if (p && p.ok && p.done) {
      if (p.stage === 'xsts' && p.xstsToken && p.uhs) {
        // Quiet finish on-device; failures stay silent until next open.
        try {
          const login = await mcNative('/authentication/login_with_xbox', '', { identityToken: 'XBL3.0 x=' + p.uhs + ';' + p.xstsToken });
          const mcToken = login.json && login.json.access_token;
          if (login.status === 200 && mcToken) {
            let ownsJava = !!v.ownsJava, name = v.name || '', uuid = v.uuid || '';
            try {
              const ent = await mcNative('/entitlements/mcstore', mcToken, null);
              const items = (ent.json && ent.json.items) || [];
              ownsJava = items.some((it) => it && (it.name === 'game_minecraft' || it.name === 'product_minecraft'));
            } catch (_) {}
            try {
              const prof = await mcNative('/minecraft/profile', mcToken, null);
              if (prof.status === 200 && prof.json) { name = prof.json.name || name; uuid = prof.json.id || uuid; }
            } catch (_) {}
            saveVerify({ name, uuid, ownsJava, mcToken, msRefresh: p.msRefresh || v.msRefresh, at: Date.now() });
            renderAcct();
          }
        } catch (_) {}
        return;
      }
      saveVerify({ name: p.name, uuid: p.uuid, ownsJava: !!p.ownsJava, mcToken: p.mcToken || null, msRefresh: p.msRefresh || v.msRefresh, at: Date.now() });
      renderAcct();
    }
  } catch (_) {}
}

function parseHostPort(raw) {
  const s = String(raw || '').trim().toLowerCase().replace(/^(https?:\/\/|minecraft:\/\/)/, '').split('/')[0];
  const m = s.match(/^(.*?)(?::(\d+))?$/);
  if (!m) return null;
  const host = m[1];
  const port = m[2] ? parseInt(m[2], 10) : 25565;
  if (!host || host.length > 253 || !/^[a-z0-9.-]+$/.test(host) || !(port >= 1 && port <= 65535)) return null;
  return { host, port };
}

// Public fallback ping via mcsrvstat.us (allows browser CORS, needs no
// BlockForge server). Used when our backend is unreachable or stale.
async function publicPing(hp) {
  try {
    const ctl = new AbortController();
    const to = setTimeout(() => { try { ctl.abort(); } catch (_) {} }, 8000);
    const resp = await fetch('https://api.mcsrvstat.us/3/' + encodeURIComponent(hp.host) + (hp.port === 25565 ? '' : ':' + hp.port), { signal: ctl.signal });
    clearTimeout(to);
    const j = await resp.json();
    if (!j) return { ok: true, online: false, reason: 'no response.' };
    if (!j.online) return { ok: true, online: false, reason: 'offline.' };
    let motd = '';
    try {
      const m = j.motd || {};
      const parts = m.clean || m.raw || [];
      motd = (Array.isArray(parts) ? parts.join(' ') : String(parts)).replace(/§[0-9a-fk-or]/g, '').slice(0, 120);
    } catch (_) {}
    const ver = typeof j.version === 'string' ? j.version : ((j.version && j.version.name) || '');
    return {
      ok: true, online: true, src: 'public',
      version: ver,
      playersOnline: (j.players && j.players.online) || 0,
      playersMax: (j.players && j.players.max) || 0,
      motd, icon: j.icon || null,
    };
  } catch (_) { return { ok: true, online: false, reason: 'unreachable.' }; }
}

function copyText(t) {
  try {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(t).catch(() => fallbackCopy(t));
      return;
    }
  } catch (_) {}
  fallbackCopy(t);
}
function fallbackCopy(t) {
  try {
    const ta = document.createElement('textarea');
    ta.value = t;
    ta.style.cssText = 'position:fixed;opacity:0;';
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    ta.remove();
  } catch (_) {}
}

async function doSearch() {
  const input = _panel.querySelector('#bf-java-ip');
  const resBox = _panel.querySelector('#bf-java-results');
  const hp = parseHostPort(input.value);
  if (!hp) {
    resBox.innerHTML = '<div style="color:#f55;">Enter an IP like <b>mc.hypixel.net</b> or <b>play.example.com:25570</b>.</div>';
    return;
  }
  const key = hp.host + (hp.port === 25565 ? '' : ':' + hp.port);
  resBox.innerHTML = '<div style="color:#aaa;">Pinging ' + esc(key) + '…</div>';
  let r = null;
  try {
    const ctl = new AbortController();
    const to = setTimeout(() => { try { ctl.abort(); } catch (_) {} }, 4000);
    const resp = await fetch(backend() + '/api/mc-ping', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(hp), signal: ctl.signal,
    });
    clearTimeout(to);
    const j = await resp.json();
    if (j && j.ok) r = j;
  } catch (_) { r = null; }
  if (!r || !r.ok || !r.online) r = await publicPing(hp);
  if (!r || !r.ok || !r.online) {
    resBox.innerHTML = '<div style="color:#f55;">⛔ ' + esc(key) + ' — ' + esc((r && r.reason) || 'offline.') + '</div>';
    return;
  }
  const recent = [key, ...loadRecent().filter(x => x !== key)];
  saveRecent(recent);
  const icon = r.icon ? '<img src="' + r.icon + '" style="width:32px;height:32px;border-radius:4px;"/>' : '<div style="width:32px;height:32px;border-radius:4px;background:#2a2a3a;display:flex;align-items:center;justify-content:center;">🟢</div>';
  resBox.innerHTML =
    '<a href="#" id="bf-java-hit" data-bfmod="java-bridge" style="display:flex;gap:10px;align-items:center;padding:10px;border:1px solid #2a6a3a;border-radius:8px;background:rgba(40,180,80,0.08);text-decoration:none;color:#ddd;">' +
    icon +
    '<div style="flex:1;min-width:0;">' +
    '<div><b style="color:#8f8;">' + esc(key) + '</b> <span style="color:#888;">' + esc(r.version || '') + '</span></div>' +
    '<div style="color:#aaa;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + esc(cleanMotd(r.motd)) + '</div>' +
    '<div style="color:#8af;font-size:11px;" id="bf-java-detail"></div>' +
    '</div>' +
    '<div style="color:#8f8;">👥 ' + (r.playersOnline || 0) + '/' + (r.playersMax || 0) + '</div>' +
    '</a>' +
    '<button id="bf-java-join" style="background:#2a6a3a;color:#fff;border:none;border-radius:8px;padding:10px;font:bold 13px monospace;cursor:pointer;">⛏️ JOIN — copy server IP</button>' +
    '<div style="font-size:11px;color:#888;">Browsers can\u2019t enter Java servers directly — JOIN copies the IP. Then open <b>Minecraft Java → Multiplayer → Add Server</b> and paste it.</div>';
  const hit = resBox.querySelector('#bf-java-hit');
  const joinBtn = resBox.querySelector('#bf-java-join');
  const doJoin = () => {
    copyText(key);
    const d = resBox.querySelector('#bf-java-detail');
    if (d) d.textContent = 'IP copied! Minecraft Java → Multiplayer → Add Server → paste → Join Server.';
  };
  hit.onclick = (e) => {
    e.preventDefault();
    doJoin();
  };
  joinBtn.onclick = (e) => {
    e.preventDefault();
    doJoin();
  };
  renderRecent();
}

function renderRecent() {
  if (!_panel) return;
  const resBox = _panel.querySelector('#bf-java-results');
  if (!resBox || resBox.querySelector('#bf-java-hit')) return;
  const recent = loadRecent();
  if (!recent.length) return;
  resBox.innerHTML = '<div style="color:#888;font-size:11px;margin-bottom:4px;">Recent:</div>' +
    recent.map(k => '<a href="#" data-ip="' + esc(k) + '" class="bf-java-recent" style="color:#8af;font-size:12px;display:block;padding:2px 0;">' + esc(k) + '</a>').join('');
  resBox.querySelectorAll('.bf-java-recent').forEach(a => {
    a.onclick = (e) => {
      e.preventDefault();
      _panel.querySelector('#bf-java-ip').value = a.dataset.ip;
      doSearch();
    };
  });
}

export function onLoad(api) {
  _api = api;
  api.addButton('java', '⛏️ Java Servers', openPanel);
}

export function onUnload(api) {
  closePanel();
  try { api.removeButton('java'); } catch (_) {}
  _api = null;
}
