// ─── BlockForge Mod: Night Vision ─────────────────────────────────────────
// Boosts brightness & shifts to a green-tinted vision, with auto-activation
// during the night cycle. Toggle anytime with N.
//
// How to install: open BlockForge → Mods & Addons → Import Mod → pick this
// .bfmod file (or drag & drop it onto the menu).

export const manifest = {
  id: 'bf-nightvision',
  name: 'Night Vision',
  version: '1.0',
  description: 'Green-tinted low-light vision with an automatic night mode. Toggle with N.',
  author: 'BlockForge Dev',
  icon: '🌙',
};

let enabled = true;
let _filterEl = null;
let _lastState = false;

function _el() {
  if (_filterEl) return _filterEl;
  _filterEl = document.createElement('div');
  _filterEl.id = 'bf-hud-nightvision';
  _filterEl.dataset.bfmod = 'bf-nightvision';
  _filterEl.style.cssText = 'position:fixed;inset:0;pointer-events:none;z-index:95;mix-blend-mode:screen;opacity:0;transition:opacity .4s;' +
    'background:radial-gradient(ellipse at center, rgba(40,90,40,0.0) 0%, rgba(20,60,30,0.55) 100%), rgba(30,80,40,0.12);';
  document.body.appendChild(_filterEl);
  return _filterEl;
}

function apply(active) {
  if (active === _lastState) return;
  _lastState = active;
  const el = _el();
  el.style.opacity = active ? '1' : '0';
}

export function onLoad(api) {
  const toggle = (e) => {
    if (e.key !== 'n' && e.key !== 'N') return;
    if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
    enabled = !enabled;
    api.hud.upsert('badge', enabled ? 'NIGHT VISION <b style="color:#7f7">ON</b>' : 'NIGHT VISION <b style="color:#f88">OFF</b>',
      { top: '48px', left: '10px', background: 'rgba(0,0,0,0.55)', padding: '3px 8px', borderRadius: '6px', font: 'bold 10px monospace', color: '#cfc' });
    setTimeout(() => api.hud.remove('badge'), 1600);
  };
  document.addEventListener('keydown', toggle);
  _onToggle = toggle;
  _el();
  apply(false);
}

let _onToggle = null;

export function onTick(dt, api) {
  if (!enabled) { apply(false); return; }
  if (!api.inGame()) { apply(false); return; }
  const t = api.getTime();
  const night = t.night;
  apply(night);
}

export function onUnload() {
  if (_onToggle) document.removeEventListener('keydown', _onToggle);
  _onToggle = null;
  if (_filterEl) { _filterEl.remove(); _filterEl = null; }
  _lastState = false;
}