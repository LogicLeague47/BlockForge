// ─── BlockForge Mod: Motion FOV ───────────────────────────────────────────
// Widens the field of view as you move faster (sprint, fly, fall) for a
// cinematic "speed lines" feel. Toggle with G.
//
// How to install: open BlockForge → Mods & Addons → Import Mod → pick this
// .bfmod file (or drag & drop it onto the menu).

export const manifest = {
  id: 'bf-motion-fov',
  name: 'Motion FOV',
  version: '1.0',
  description: 'Dynamic field of view that widens with movement speed. Toggle with G.',
  author: 'BlockForge Dev',
  icon: '💨',
};

let enabled = true;
let _onToggle = null;
let BASE_FOV = 70;
let _lockFov = null;

export function onLoad(api) {
  _onToggle = (e) => {
    if (e.key !== 'g' && e.key !== 'G') return;
    if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
    enabled = !enabled;
    if (!enabled) _lockFov = null;
    api.hud.upsert('badge', 'MOTION FOV <b style="color:' + (enabled ? '#7f7' : '#f88') + '">' + (enabled ? 'ON' : 'OFF') + '</b>',
      { top: '84px', left: '10px', background: 'rgba(0,0,0,0.55)', padding: '3px 8px', borderRadius: '6px', font: 'bold 10px monospace', color: '#fff' });
    setTimeout(() => api.hud.remove('badge'), 1400);
  };
  document.addEventListener('keydown', _onToggle);
}

export function onTick(dt, api) {
  const refs = api.refs();
  if (!refs || !refs.camera || !refs.player) return;
  const cam = refs.camera;
  if (_lockFov == null) { _lockFov = cam.fov; BASE_FOV = _lockFov; }
  if (!enabled || !api.inGame()) {
    if (Math.abs(cam.fov - BASE_FOV) > 0.1) {
      cam.fov = BASE_FOV;
      cam.updateProjectionMatrix();
    }
    return;
  }

  const p = refs.player;
  const vx = p.velocity ? Math.abs(p.velocity.x) : 0;
  const vy = p.velocity ? Math.abs(p.velocity.y) : 0;
  const vz = p.velocity ? Math.abs(p.velocity.z) : 0;
  const speed = Math.sqrt(vx * vx + vy * vy + vz * vz);

  const extra = enabled ? Math.min(28, speed * 1.6) : 0;
  const target = BASE_FOV + extra;
  cam.fov += (target - cam.fov) * Math.min(1, dt * 6);
  cam.updateProjectionMatrix();
}

export function onUnload(api) {
  const refs = api.refs();
  if (_onToggle) document.removeEventListener('keydown', _onToggle);
  _onToggle = null;
  if (refs && refs.camera) {
    refs.camera.fov = BASE_FOV;
    refs.camera.updateProjectionMatrix();
  }
  _lockFov = null;
}