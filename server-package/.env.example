# Copy this file to ".env" and edit the values.
# Public ws address other players type in BlockForge (Minecraft-Java style).
# Find your public IP at https://api.ipify.org and forward PORT on your router.
PUBLIC_WS_URL=ws://YOUR_PUBLIC_IP:4000

# Where your server appears in the Live Servers list (portal + in-game).
# Point this at the BlockForge directory endpoint.
DIRECTORY_URL=https://blockforge-server.onrender.com/api/servers

# How your server appears in the list.
SERVER_NAME=My BlockForge Server
SERVER_ID=my-server-1
SERVER_DESC=A chill survival world — come build with us!
IS_OFFICIAL=false

# Port the server listens on.
PORT=4000
