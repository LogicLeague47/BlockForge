# Copy this file to ".env" and edit the values.
# Public ws address other players type in BlockForge (BlockForge-Java style).
# Find your public IP at https://api.ipify.org and forward PORT on your router.
# Use a domain (e.g. play.myserver.net) if you have one — players type that.
PUBLIC_WS_URL=ws://YOUR_PUBLIC_IP:4000

# Where your server appears in the Community Servers list (portal + in-game).
# Point this at the BlockForge directory endpoint.
DIRECTORY_URL=https://blockforge-server.onrender.com/api/servers

# Social backend. Your server is ONLY the game host (worlds/blocks/players);
# accounts, friends, DMs and community chat are relayed to the official backend
# so they keep working for your players. Leave this as the official backend.
UPSTREAM_BACKEND_URL=wss://blockforge-server.onrender.com

# How your server appears in the list.
SERVER_NAME=My BlockForge Server
SERVER_ID=my-server-1
SERVER_DESC=A chill survival world — come build with us!
# A player-hosted server relays social to the official backend — leave this false.
IS_OFFICIAL=false

# Port the server listens on.
PORT=4000

# NPC voices (ElevenLabs TTS) + Java Bridge verifier options.
# NEVER commit real keys — set them in the Render dashboard (service →
# Environment) or a local .env file (gitignored).
# Get a key at https://elevenlabs.io (free tier: 10k chars/month).
ELEVENLABS_API_KEY=
# Default narrator voice (Sarah). Use any voice ID from your dashboard.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Microsoft client ID for Java account verification (default: public client).
MC_CLIENT_ID=00000000402b5328
# Local port of the Sisu verifier sidecar (spawned automatically if present).
SISU_PORT=12737
