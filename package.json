{
  "name": "minecraft-clone",
  "version": "1.0.0",
  "description": "A voxel sandbox Minecraft clone built with Three.js",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-downloads.mjs",
    "preview": "vite preview",
    "server": "node server.js",
    "start": "node server.js",
    "build:cg": "vite build --mode cg && node scripts/strip-cg.mjs",
    "package": "bash package.sh",
    "lint": "eslint src/",
    "typecheck": "echo 'No TS setup yet'"
  },
  "build": {
    "appId": "com.blockforge.game",
    "productName": "BlockForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": ["portable"],
      "artifactName": "BlockForge-windows.exe"
    },
    "mac": {
      "target": ["dmg"],
      "artifactName": "BlockForge-mac-${arch}.dmg"
    },
    "linux": {
      "target": ["AppImage"],
      "artifactName": "BlockForge-linux.${ext}"
    }
  },
  "dependencies": {
    "simplex-noise": "^4.0.1",
    "three": "^0.169.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0"
  }
}
